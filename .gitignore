# ---- 通用临时文件 ----
.~*
~$*
.DS_Store
*.kimi-rollback-*.tmp
.fold-*/
*.tmp-*

# ---- Python ----
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# ---- 编辑器/工具索引 ----
tags

# ---- 黄金模型输出（由 model/experiments 脚本再生成） ----
model/out/

# ---- 仿真构建与波形（cocotb / VCS / Verdi） ----
sim_build*/
*.vcd
*.fsdb
verdiLog/
vfastLog/
fsdb2vcdLog/
novas.log

# ---- 仿真数据 dump（可由 tb 脚本再生成；需要入库时 git add -f） ----
tb/**/*.npz
tb/**/*.npy

# ---- codewhale 运行状态（易变；reports/ 与 workflow-runs.jsonl 保留） ----
.codewhale/state/

# ---- Verdi 会话配置（工具持续改写；如需版本化用 git add -f） ----
novas.conf
novas.rc

# ---- analog: ngspice 数据导出（可由 .cir 再生成; 图 *.png 仍入库） ----
analog/**/*.csv
analog/*.csv
