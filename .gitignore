# ---- 通用临时文件 ----
.~*
~$*
.DS_Store
*.kimi-rollback-*.tmp
.fold-*/
*.tmp-*

# ---- Python ----
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# ---- 编辑器/工具索引 ----
tags

# ---- 黄金模型输出（由 model/experiments 脚本再生成） ----
model/out/

# ---- 仿真构建与波形（cocotb / VCS / Verdi） ----
sim_build*/
*.vcd
*.fsdb
verdiLog/
vfastLog/
fsdb2vcdLog/
novas.log

# ---- 仿真数据 dump（可由 tb 脚本再生成；需要入库时 git add -f） ----
tb/**/*.npz
tb/**/*.npy

# ---- codewhale 运行状态（工具内部物；发布排除, 本地保留） ----
.codewhale/

# ---- Verdi 会话配置（工具持续改写；如需版本化用 git add -f） ----
novas.conf
novas.rc

# ---- analog 域（本地保留, 不随本仓库发布; 原 ngspice csv 规则被整体覆盖） ----
analog/

# 边界回归中间产物（每次重跑生成）
model/out/dual_mc/boundary_reg/ev_*.txt
